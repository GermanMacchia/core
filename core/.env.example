# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core_db
DB_USER=core_user
DB_PASSWORD=secret
DB_MAX_CONNS=25

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret

# Auth
JWT_SECRET=super-secret-change-in-production
JWT_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30

# Server
PORT=8080
ENV=development

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,https://app.tu-dominio.com

# Superadmin inicial (seed)
SEED_ADMIN_EMAIL=admin@tu-dominio.com
SEED_ADMIN_PASSWORD=changeme123

# API key para rutas públicas (/api/v1/public/*)
PUBLIC_API_KEY=change-me-in-production
