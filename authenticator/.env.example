# Database (shared with core)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=core_db
DB_USER=core_user
DB_PASSWORD=secret
DB_MAX_CONNS=10

# Redis (shared with core)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=secret

# Auth — MUST match the JWT_SECRET used by core
JWT_SECRET=super-secret-change-in-production
JWT_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30

# Server
PORT=8081
ENV=development

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:4200,https://app.tu-dominio.com
